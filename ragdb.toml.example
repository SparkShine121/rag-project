# ragdb 配置示例：复制为 ragdb.toml 后按需修改；未列出的项取内置默认值
# 完整字段见 src/ragdb/config.py 与 docs/superpowers/specs/2026-09-08-rag-database-design.md §5.1

# vault_path = "~/Documents/Obsidian Vault"   # 知识库根目录（只读）
# data_dir = "~/Library/Application Support/ragdb"  # 向量库/状态库/锁文件
# port = 8770              # FastAPI 监听端口（仅 127.0.0.1）
# interval_secs = 30       # 后台增量同步周期；0 = 关闭循环（CLI 手动 sync）
# recall_k = 20            # 向量召回候选数
# top_k = 5                # 重排后返回条数
# token_budget = 3000      # 单次检索返回的 token 预算
# embed_model = "BAAI/bge-m3"
# rerank_model = "BAAI/bge-reranker-v2-m3"
# device = "mps"           # mps / cpu
# dtype = "float16"        # MPS 数值不稳时可降级 float32
# embed_batch = 32

# [chunk]
# min_chars = 100          # 短于此并入上级
# max_tokens = 500         # 超长按段落二切
# short_note_tokens = 600  # 整笔记低于此值时整篇返回

# 环境变量覆盖（优先级高于本文件）：RAGDB_PORT、RAGDB_TOP_K、RAGDB_DEVICE …
# 模型下载镜像：HF_ENDPOINT=https://hf-mirror.com
