  "cards": [
    {
      "dot": "cyan",
      "title": "多知识源（v1.2）",
      "items": [
        "[[sources]] 可同时接入 Obsidian vault、GitHub 仓库与本地 folder",
        "来源名即检索路径前缀（obsidian/…、myrepo/…）",
        "GitHub 走 Git Blobs API，blob-sha 增量零下载判变更"
      ]
    },
    {
      "dot": "emerald",
      "title": "单写者摄取管线",
      "items": [
        "SyncEngine 持 ragdb.lock，是唯一写者",
        "IngestPipeline 按扩展名分发：md / 代码启发式 / PDF 按页",
        "移动零重嵌入；来源增删自动清理孤儿索引"
      ]
    },
    {
      "dot": "violet",
      "title": "检索与模型",
      "items": [
        "Retriever：召回 top-20 → 精排前 5 → small-to-big 聚合",
        "bge-m3 + bge-reranker 跑在本机 MPS（fp16）",
        "扫描版 PDF 自动回退 Apple Vision OCR"
      ]
    }
